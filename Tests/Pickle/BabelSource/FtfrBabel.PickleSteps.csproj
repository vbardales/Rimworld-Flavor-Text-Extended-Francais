<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Steps that drive RimBabel, in a companion of their own (../BabelMod): this assembly binds to RimBabel.dll,
    so it may only be staged by a pass that stages RimBabel (wsl-deps.babel.map).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FtfrBabel.PickleSteps</AssemblyName>
    <RootNamespace>FtfrBabel.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\BabelMod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RimBabel">
      <HintPath>..\..\..\..\..\RimBabel\Mod\Assemblies\RimBabel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
