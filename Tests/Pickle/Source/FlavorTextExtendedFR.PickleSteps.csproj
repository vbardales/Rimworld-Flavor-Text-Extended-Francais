<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Step definitions for the Pickle suite in ../Mod/Pickle/Features. Only Pickle loads this
    assembly: it lives in the companion test mod, never in the Mod/ folder that goes to the
    Workshop. Mirrors FieldworkCompanions/Tests/Pickle/Source.

    It is bound against the shipped assemblies rather than copies: FlavorTextExtendedFR.dll from
    Mod/Assemblies and hekmo's FlavorText.dll from the Workshop folder. A step naming something
    either has since renamed fails at build, not in the middle of a WSL run.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FlavorTextExtendedFR.PickleSteps</AssemblyName>
    <RootNamespace>FlavorTextExtendedFR.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <FlavorTextDll Condition="'$(FlavorTextDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3245374432\1.6\Assemblies\FlavorText.dll</FlavorTextDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time stubs only: the game, Harmony and the Pickle mod supply the real assemblies. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound by name at run time: RimWorld loads both before Pickle loads this assembly. -->
    <Reference Include="FlavorTextExtendedFR">
      <HintPath>..\..\..\Mod\Assemblies\FlavorTextExtendedFR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FlavorText">
      <HintPath>$(FlavorTextDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
